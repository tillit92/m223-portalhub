<% content_for :title, "Protokoll - PortalHub" %>

<%= render "admin/shared/tabs", current: :activities %>

<div class="page__header">
  <h1 class="page__title">Protokoll</h1>
  <p class="lead">Wer wann was getan hat. Die letzten <%= Admin::ActivitiesController::LIMIT %> Einträge, die neuesten zuerst.</p>
</div>

<% if @activities.any? %>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th scope="col">Zeit</th>
          <th scope="col">Wer</th>
          <th scope="col">Aktion</th>
          <th scope="col">Beschreibung</th>
        </tr>
      </thead>
      <tbody>
        <% @activities.each do |activity| %>
          <tr>
            <td class="table__nowrap mono"><%= activity_time(activity) %></td>
            <th scope="row"><%= activity.user_name || "Unbekannt" %></th>
            <td class="table__nowrap"><span class="tag <%= "tag--full" if activity.action == "login_failed" %>"><%= activity.action_label %></span></td>
            <td><%= activity.details %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="empty">
    <p class="empty__title">Noch nichts passiert.</p>
    <p class="lead">Sobald jemand etwas tut, steht es hier.</p>
  </div>
<% end %>
