<%= form_with model: [ :admin, portal ], class: "form form--wide" do |form| %>
  <% portal.errors[:base].each do |message| %>
    <div class="flash flash--alert" role="alert"><%= message %></div>
  <% end %>

  <%= render "shared/field", form: form, record: portal, attribute: :name, label: "Name", kind: :text_field %>
  <%= render "shared/field", form: form, record: portal, attribute: :dimension, label: "Dimension", kind: :text_field %>
  <%= render "shared/field", form: form, record: portal, attribute: :departure_time, label: "Abflugzeit", kind: :datetime_local_field %>
  <%= render "shared/field", form: form, record: portal, attribute: :capacity, label: "Kapazität", kind: :number_field, options: { min: 1 } %>

  <div class="form__actions">
    <%= form.submit "Speichern", class: "button" %>
    <%= link_to "Abbrechen", admin_portals_path, class: "button button--ghost" %>
  </div>
<% end %>
