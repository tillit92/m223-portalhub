<%= form_with model: [ :admin, portal ], class: "form form--wide" do |form| %>
  <% portal.errors[:base].each do |message| %>
    <div class="flash flash--alert" role="alert"><%= message %></div>
  <% end %>

  <% { name: [ "Name", :text_field ], dimension: [ "Dimension", :text_field ],
       departure_time: [ "Abflugzeit", :datetime_local_field ], capacity: [ "Kapazität", :number_field ] }.each do |attribute, (label, kind)| %>
    <div class="field <%= "field--error" if portal.errors[attribute].any? %>">
      <%= form.label attribute, label %>
      <%= form.public_send kind, attribute, required: true, min: (1 if attribute == :capacity),
            aria: { invalid: portal.errors[attribute].any?.presence } %>
      <% portal.errors[attribute].each do |message| %>
        <p class="field__error"><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div class="form__actions">
    <%= form.submit "Speichern", class: "button" %>
    <%= link_to "Abbrechen", admin_portals_path, class: "button button--ghost" %>
  </div>
<% end %>
