<% own_account = user.persisted? && user == Current.user %>
<%= form_with model: [ :admin, user ], class: "form form--wide" do |form| %>
  <%= render "shared/field", form: form, record: user, attribute: :name, label: "Name", kind: :text_field %>
  <%= render "shared/field", form: form, record: user, attribute: :email_address, label: "E-Mail", kind: :email_field %>

  <div class="field <%= "field--error" if user.errors[:role].any? %>">
    <%= form.label :role, "Rolle" %>
    <%= form.select :role, User.roles.keys.map { |role| [ role_label(role), role ] }, {}, disabled: own_account, aria: { invalid: user.errors[:role].any?.presence } %>
    <% user.errors[:role].each do |message| %>
      <p class="field__error"><%= message %></p>
    <% end %>
    <% if own_account %>
      <p class="field__hint">Die eigene Rolle lässt sich nicht ändern, damit es immer einen Admin gibt.</p>
    <% end %>
  </div>

  <%= render "shared/field", form: form, record: user, attribute: :password,
        label: (user.persisted? ? "Neues Passwort (leer lassen, um es nicht zu ändern)" : "Startpasswort (mindestens 8 Zeichen)"),
        kind: :password_field, options: { required: !user.persisted?, autocomplete: "new-password", minlength: 8 } %>

  <div class="form__actions">
    <%= form.submit "Speichern", class: "button" %>
    <%= link_to "Abbrechen", admin_users_path, class: "button button--ghost" %>
  </div>
<% end %>
