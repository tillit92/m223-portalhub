<% content_for :title, "#{@portal.name} - PortalHub" %>

<%= link_to root_path, class: "back-link" do %>&larr; Zurück zur Übersicht<% end %>

<div class="detail">
  <div class="detail__info">
    <h1 class="page__title"><%= @portal.name %></h1>

    <% if @portal.full? || @portal.departed? %>
      <p class="detail__tags">
        <% if @portal.departed? %><span class="tag">ABGEFLOGEN</span><% end %>
        <% if @portal.full? %><span class="tag tag--full">AUSGEBUCHT</span><% end %>
      </p>
    <% end %>

    <dl class="facts">
      <div class="facts__item">
        <dt>Dimension</dt>
        <dd class="mono"><%= @portal.dimension %></dd>
      </div>
      <div class="facts__item">
        <dt>Abflug</dt>
        <dd><%= departure_label(@portal) %></dd>
      </div>
      <div class="facts__item">
        <dt>Kapazität</dt>
        <dd class="mono"><%= @portal.capacity %></dd>
      </div>
      <div class="facts__item">
        <dt>Reserviert</dt>
        <dd class="mono"><%= @portal.booked_seats %></dd>
      </div>
      <div class="facts__item">
        <dt>Frei</dt>
        <dd class="mono"><%= @portal.free_seats %></dd>
      </div>
    </dl>

    <%= seat_pips(@portal) %>

    <div class="detail__action">
      <% if @portal.departed? %>
        <p class="note">Dieses Portal ist schon abgeflogen.</p>
      <% elsif @portal.reserved_by?(Current.user) %>
        <p class="note note--good">Dein Platz ist reserviert.</p>
      <% else %>
        <%= button_to "Platz reservieren", portal_bookings_path(@portal), class: "button", disabled: @portal.full? %>
        <% if @portal.full? %>
          <p class="note">Kein Platz mehr frei. Versuch eine andere Dimension.</p>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="detail__stage">
    <%= render "shared/portal" %>
  </div>
</div>
